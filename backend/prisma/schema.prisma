generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CrawledSite {
  id        String   @id @default(uuid())
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrawledPage {
  id        String   @id @default(uuid())
  url       String   @unique
  siteUrl   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
