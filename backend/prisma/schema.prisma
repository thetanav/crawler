generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CrawledSite {
  id        String         @id @default(uuid())
  url       String         @unique
  pages     CrawledPage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([createdAt])
}

model CrawledPage {
  id        String       @id @default(uuid())
  url       String       @unique
  siteUrl   String
  title     String
  site      CrawledSite? @relation(fields: [siteUrl], references: [url], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([siteUrl])
  @@index([title])
  @@index([createdAt])
}
